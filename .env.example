GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=600
MAX_FRAMES=8
GEMINI_TIMEOUT_SECONDS=90
AWS_PROFILE=default
AWS_REGION=ap-south-1
# Enable only after confirming the account's free plan/remaining allowance.
AWS_USAGE_ENABLED=false
S3_BUCKET=
SQS_QUEUE_URL=
DATABASE_PATH=data/instawork.db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE=data/models

SEARCH_MIN_SIMILARITY=0.60

# Experimental local image tagging; default remains verified Gemini.
TAGGING_PROVIDER=gemini
IMAGE_MODEL_CACHE=data/models
