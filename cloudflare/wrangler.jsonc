{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Separate from the existing "framer" proxy Worker (deploy/cloudflare/), which
  // owns framer.haciensus.com. This Worker only serves *.workers.dev until cutover.
  "name": "framer-cf-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "0187f7c38bf35a8abcc4e9f9abfa213e",
  "workers_dev": true,
  "preview_urls": false,
  // No "routes" on purpose: DNS/custom domains are changed only at cutover, by the owner.

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Cron consumer for the Postgres ingestion queue (Workers Free: 5 crons/account).
  "triggers": { "crons": ["* * * * *"] },

  "ai": { "binding": "AI" },

  // OWNER: create with `wrangler hyperdrive create framer-cf-db --connection-string=...`
  // and paste the returned id. Until then `wrangler deploy` fails on purpose.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "REPLACE_WITH_HYPERDRIVE_ID" }
  ],

  // OWNER: R2 must be enabled in the dashboard first; then `wrangler r2 bucket create framer-cf-videos`.
  "r2_buckets": [
    { "binding": "VIDEOS", "bucket_name": "framer-cf-videos" }
  ],

  "vars": {
    "R2_ACCOUNT_ID": "0187f7c38bf35a8abcc4e9f9abfa213e",
    "R2_BUCKET_NAME": "framer-cf-videos",
    "GEMINI_MODEL": "gemini-3.5-flash",
    "EMBEDDING_MODEL": "@cf/baai/bge-small-en-v1.5",
    "MAX_UPLOAD_MB": "400",
    "MAX_VIDEO_SECONDS": "600",
    "MAX_FRAMES": "16",
    "SEARCH_MIN_SIMILARITY": "0.60",
    "DUPLICATE_SIMILARITY_THRESHOLD": "0.95",
    "PUBLIC_DEMO_LIMITS": "true",
    "DAILY_UPLOAD_LIMIT": "10",
    "DAILY_QUERY_LIMIT": "100",
    "QUEUE_STEPS_PER_TICK": "2"
  },
  // Secrets (set with `wrangler secret put`, never committed):
  //   GEMINI_API_KEY, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY

  "observability": { "enabled": true },

  "env": {
    // Bindings-free smoke deployment (framer-cf-smoke.<subdomain>.workers.dev):
    // serves the UI and /health; data routes answer 503 until the real bindings exist.
    "smoke": {
      "name": "framer-cf-smoke",
      "triggers": { "crons": [] },
      "vars": { "PUBLIC_DEMO_LIMITS": "true" }
    }
  }
}
